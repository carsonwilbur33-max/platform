# Copy to .env (or .env.local) and fill in. Every variable is optional for local development.
# Both `npm run dev` and the database scripts (`npm run setup`, db:*) read these files.

# --- Database -------------------------------------------------------------
# Leave unset to use the embedded local database in .data/pglite (no install needed).
# Set it to use a hosted Postgres (Neon/Supabase), e.g. in production:
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Seed (npm run setup / npm run db:seed) -------------------------------
# Login created for the demo coach account. Defaults shown.
SEED_COACH_EMAIL=coach@example.com
SEED_COACH_PASSWORD=changeme123

# --- Safety switch ---------------------------------------------------------
# `npm run db:reset` refuses to wipe a hosted DATABASE_URL unless this is 1.
# Set it only for the one command, never leave it in a file:
#   ALLOW_RESET=1 npm run db:reset
